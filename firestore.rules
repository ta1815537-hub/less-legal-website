rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidEmail(email) {
      return email is string && email.size() > 3 && email.size() <= 120;
    }

    match /account_deletion_requests/{requestId} {
      allow create: if request.resource.data.email is string
                    && isValidEmail(request.resource.data.email)
                    && request.resource.data.ticketId is string;
      allow read, update, delete: if true;
    }

    match /contact_submissions/{submissionId} {
      allow create: if request.resource.data.email is string
                    && isValidEmail(request.resource.data.email)
                    && request.resource.data.name is string;
      allow read, update, delete: if true;
    }

    
    match /user_subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // Only written by Cloudflare Worker Service Account
    }
    match /razorpay_payments/{paymentId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false; // Only written by Cloudflare Worker Service Account
    }
    match /memberships/{membershipId} {
      allow read, create, update: if true;
    }

    match /payment_transactions/{transactionId} {
      allow read, create, update: if true;
    }

    match /admin_config/{configId} {
      allow read, write: if true;
    }
  }
}
